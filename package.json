{
  "name": "prompt-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "VITE_DEBUG=true vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build": "docker build -t prompt-board .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production prompt-board",
    "docker:dev": "docker-compose --profile dev up",
    "docker:prod": "docker-compose --profile prod up --build",
    "docker:local": "docker-compose -f docker-compose.local.yml --profile local up",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "test:all": "npm run test:run && npm run test:integration:run",
    "test:all:local": "npm run supabase:start && npm run test:all",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts --watch",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:restart": "supabase stop && supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:studio": "supabase studio",
    "dev:local": "npm run supabase:start && npm run dev",
    "test:local": "npm run supabase:start && npm run test",
    "test:integration:local": "npm run supabase:start && npm run test:integration:run",
    "test:docker": "docker-compose -f docker-compose.test.yml up --build --abort-on-container-exit",
    "test:docker:clean": "docker-compose -f docker-compose.test.yml down -v",
    "build:analyze": "ANALYZE=true npm run build",
    "deploy": "deployment/scripts/deploy.sh",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "docs:build": "typedoc",
    "docs:serve": "npm run docs:build && npx http-server docs/api",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lighthouse": "lighthouse http://localhost:4173 --output-path=./lighthouse-report.html",
    "bundle:analyze": "bundlesize",
    "audit:security": "npm audit --audit-level high",
    "audit:critical": "npm audit --audit-level critical",
    "audit:report": "npm audit --json > security-audit-$(date +%Y%m%d).json",
    "audit:fix": "npm audit fix --only=prod",
    "audit:deps": "npm outdated",
    "preview:prod": "npm run build && npm run preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.9.0",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@sentry/react": "^9.38.0",
    "@sentry/vite-plugin": "^3.5.0",
    "@supabase/supabase-js": "^2.50.4",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/uuid": "^10.0.0",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.3.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "eventsource-parser": "^3.0.3",
    "flexsearch": "^0.8.205",
    "framer-motion": "^12.23.3",
    "fuse.js": "^7.1.0",
    "immer": "^10.1.1",
    "json-schema": "^0.4.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.454.0",
    "lunr": "^2.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.60.0",
    "react-hot-toast": "^2.5.2",
    "react-hotkeys-hook": "^5.1.0",
    "react-router-dom": "^6.30.1",
    "react-transition-group": "^4.4.5",
    "react-use": "^17.6.0",
    "react-use-measure": "^2.1.7",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.3.1",
    "use-debounce": "^10.0.5",
    "uuid": "^11.1.0",
    "web-vitals": "^5.0.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.54.1",
    "@sentry/tracing": "^7.120.3",
    "@storybook/react-vite": "^9.0.16",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eventsource": "^1.1.15",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "bundlesize": "^0.18.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdoc": "^4.0.4",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.8.0",
    "msw": "^2.10.4",
    "netlify-cli": "^22.2.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup-plugin-analyzer": "^4.0.0",
    "supabase": "^2.30.4",
    "tailwindcss": "^4.1.11",
    "typedoc": "^0.28.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vercel": "^44.4.1",
    "vite": "^7.0.0",
    "vite-bundle-analyzer": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
