# Environment Variables Template
# Copy this file and rename it according to your environment:
# - .env.local (for local development)
# - .env.production (for production - values set in CI/CD)
# - .env.staging (for staging environment)

# ===========================================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================================

# Application Environment
NODE_ENV=development

# Supabase Configuration
# Get these values from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (SERVER-SIDE ONLY)
# ⚠️  NEVER expose this in client-side code
# Used for migrations, admin operations, and server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Project Reference (for CLI operations)
SUPABASE_PROJECT_REF=your_project_ref

# API Keys
VITE_GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Debug logging (development only)
VITE_DEBUG=false

# Database URL (for direct connections if needed)
# DATABASE_URL=postgresql://...

# ===========================================
# SECURITY NOTES
# ===========================================
# 
# 1. NEVER commit .env files with real values to git
# 2. Use environment variables in CI/CD for production values
# 3. Rotate keys regularly
# 4. Only expose VITE_ prefixed variables to the client
# 5. Keep SERVICE_ROLE_KEY secure and server-side only
#
# ===========================================
